# ---- Supabase (cloud accounts + resume database) ----
# Project Settings → API in the Supabase dashboard.
# The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Google sign-in ----
# OAuth always runs through Supabase. Keep this Client ID paired with its
# secret in Supabase → Authentication → Providers → Google. The secret must
# NEVER be prefixed with VITE_ or bundled into the browser.
# To apply from this repo, also set SUPABASE_ACCESS_TOKEN and run
# `npm run apply:google`; otherwise paste the values in the Supabase dashboard.
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# SUPABASE_ACCESS_TOKEN=sbp_...
