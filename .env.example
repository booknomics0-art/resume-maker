# ---- Supabase (cloud accounts + resume database) ----
# Project Settings → API in the Supabase dashboard.
# The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Google sign-in ----
# Client ID is public. The secret must NEVER be prefixed with VITE_ (that would
# ship it to every browser). Save the secret in Supabase → Authentication →
# Providers → Google, or run `npm run apply:google` with SUPABASE_ACCESS_TOKEN.
VITE_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# SUPABASE_ACCESS_TOKEN=sbp_...
