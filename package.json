{
  "name": "craftcv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CraftCV — professional resume studio. Navy & silver theme, 10 fields × 5 templates, n8n AI webhook integration, offline PDF + photo OCR import.",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:ocr": "node tests/test-image-ocr.mjs",
    "test:pdf": "node tests/test-pdf-parse.mjs",
    "test": "npm run test:ocr && npm run test:pdf && npm run test:autofill",
    "test:autofill": "node tests/test-autofill.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "@napi-rs/canvas": "^1.0.9"
  },
  "allowScripts": {
    "esbuild": true,
    "tesseract.js": true
  }
}
