{
  "name": "resumemakery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ResumeMakery — free ATS resume builder with 50 professional templates, resume import/edit, cloud sync, OCR and clean PDF export.",
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "vite",
    "prebuild": "node scripts/predev.mjs",
    "build": "vite build && node scripts/prerender-seo.mjs && node scripts/seo-postprocess.mjs",
    "preview": "vite preview",
    "test:ocr": "node tests/test-image-ocr.mjs",
    "test:pdf": "node tests/test-pdf-parse.mjs",
    "test": "npm run test:auth && npm run test:templates && npm run test:score && npm run test:letter && npm run test:clean && npm run test:ats && npm run test:ats2 && npm run test:photo && npm run test:polish && npm run test:pagination && npm run test:ocr && npm run test:pdf && npm run test:autofill && npm run test:exact && npm run test:mobile-download",
    "test:autofill": "node tests/test-autofill.mjs",
    "test:exact": "node tests/test-exact-editor-v2.mjs",
    "test:mobile-download": "node tests/test-mobile-pdf-download.mjs",
    "test:polish": "node tests/test-template-polish.mjs",
    "test:pagination": "node tests/test-pagination.mjs",
    "seed:templates": "node scripts/seed-templates.mjs",
    "seed:templates:push": "node scripts/seed-templates.mjs --push",
    "test:auth": "node tests/test-google-auth.mjs",
    "check:auth": "node scripts/check-google-auth.mjs",
    "apply:google": "node scripts/apply-google-provider.mjs",
    "test:templates": "node tests/test-templates.mjs",
    "test:clean": "node tests/test-clean-export.mjs",
    "test:ats": "node tests/test-ats.mjs",
    "test:ats2": "node tests/test-ats-diagnostics.mjs",
    "test:score": "node tests/test-score-landing.mjs",
    "test:letter": "node tests/test-cover-letter.mjs",
    "preview:templates": "node scripts/render-templates.mjs",
    "test:photo": "node tests/test-photo-persistence.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1",
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "25.11.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.1",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild": true,
    "tesseract.js": true
  },
  "engines": {
    "node": "22.x"
  }
}
