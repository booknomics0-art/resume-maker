{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/ocr/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/pdf.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "excludeFiles": "{tests/**,docs/**,source/**,src/**,public/**,supabase/**,scripts/**,.github/**,README.md,netlify.toml}"
    }
  },
  "rewrites": [
    { "source": "/resume-builder", "destination": "/resume-builder/index.html" },
    { "source": "/ats-resume-checker", "destination": "/ats-resume-checker/index.html" },
    { "source": "/job-description-resume-match", "destination": "/job-description-resume-match/index.html" },
    { "source": "/ats-keyword-checker", "destination": "/ats-keyword-checker/index.html" },
    { "source": "/resume-score-checker", "destination": "/resume-score-checker/index.html" },
    { "source": "/resume-editor", "destination": "/resume-editor/index.html" },
    { "source": "/resume-templates", "destination": "/resume-templates/index.html" },
    { "source": "/resume-for-freshers", "destination": "/resume-for-freshers/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/resume-format-india", "destination": "/guides/resume-format-india/index.html" },
    { "source": "/guides/resume-summary-examples", "destination": "/guides/resume-summary-examples/index.html" },
    { "source": "/guides/resume-skills-guide", "destination": "/guides/resume-skills-guide/index.html" },
    { "source": "/guides/fresher-resume-guide", "destination": "/guides/fresher-resume-guide/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/cookies", "destination": "/cookies/index.html" },
    { "source": "/disclaimer", "destination": "/disclaimer/index.html" },
    { "source": "/eula", "destination": "/eula/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
